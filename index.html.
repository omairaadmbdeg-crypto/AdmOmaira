<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BodegaControl – Contabilidad, Diezmo e Inventario</title>
    <!-- Tailwind CSS CDN -->
    <script src="[https://cdn.tailwindcss.com](https://cdn.tailwindcss.com)"></script>
    <!-- Lucide Icons CDN -->
    <script src="[https://unpkg.com/lucide@latest](https://unpkg.com/lucide@latest)"></script>
    <style>
        body { background-color: #0b0f19; color: #f3f4f6; font-family: system-ui, -apple-system, sans-serif; }
        .card { background: #111827; border: 1px solid #1f2937; border-radius: 1rem; }
        .gold-text { color: #f59e0b; }
        .gold-bg { background-color: #f59e0b; }
    </style>
</head>
<body class="pb-12">

    <!-- Header Fijo con Tasa BCV -->
    <header class="p-4 border-b border-gray-800 bg-gray-900/90 backdrop-blur sticky top-0 z-50 flex justify-between items-center">
        <div class="flex items-center space-x-2">
            <div class="p-2 gold-bg rounded-lg text-black font-extrabold text-sm">BC</div>
            <div>
                <h1 class="font-bold text-base md:text-lg text-white leading-tight">BodegaControl</h1>
                <p class="text-[10px] md:text-xs text-gray-400">Contabilidad & diezmo multimoneda</p>
            </div>
        </div>
        <div class="flex items-center space-x-2 bg-gray-800/80 px-2.5 py-1 rounded-lg border border-gray-700">
            <span class="text-xs text-gray-400 font-medium">Tasa BCV:</span>
            <span class="text-xs gold-text font-bold">Bs.</span>
            <input type="number" step="0.01" id="tasa-bcv" class="w-16 bg-gray-900 text-white font-bold text-xs p-1 rounded text-right focus:outline-none focus:ring-1 focus:ring-yellow-500" value="36.50">
        </div>
    </header>

    <main class="p-3 md:p-6 max-w-6xl mx-auto space-y-6">

        <!-- Advertencia de almacenamiento local y Respaldos -->
        <div class="bg-blue-950/40 border border-blue-800/50 p-3 rounded-xl flex items-center justify-between text-xs text-blue-300">
            <div class="flex items-center space-x-2">
                <i data-lucide="database" class="w-4 h-4 text-blue-400 shrink-0"></i>
                <span>Datos guardados en el navegador. Recuerda exportar tu copia de seguridad.</span>
            </div>
            <div class="flex space-x-1 shrink-0 ml-2">
                <button onclick="exportarJSON()" class="px-2 py-1 bg-blue-900/60 hover:bg-blue-800 border border-blue-700 rounded text-white flex items-center gap-1 text-[11px]"><i data-lucide="download" class="w-3 h-3"></i> JSON</button>
                <button onclick="exportarCSV()" class="px-2 py-1 bg-emerald-900/60 hover:bg-emerald-800 border border-emerald-700 rounded text-white flex items-center gap-1 text-[11px]"><i data-lucide="file-spreadsheet" class="w-3 h-3"></i> CSV</button>
                <label class="px-2 py-1 bg-yellow-900/60 hover:bg-yellow-800 border border-yellow-700 rounded text-white flex items-center gap-1 text-[11px] cursor-pointer">
                    <i data-lucide="upload" class="w-3 h-3"></i> Imp
                    <input type="file" id="input-importar" accept=".json" class="hidden" onchange="importarJSON(event)">
                </label>
            </div>
        </div>

        <!-- 1. DASHBOARD GLOBAL DE LA BODEGA + MÓDULO DE DIEZMO -->
        <section class="card p-4 md:p-5">
            <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-3 flex items-center gap-2">
                <i data-lucide="layout-dashboard" class="w-4 h-4 gold-text"></i> Resumen Contable y Diezmo
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                <div class="bg-gray-900/80 p-3 rounded-xl border border-gray-800">
                    <p class="text-[11px] text-gray-400">Total Inversión</p>
                    <p id="dash-inversion-usd" class="text-base md:text-lg font-bold text-white mt-0.5">$0.00</p>
                    <p id="dash-inversion-bs" class="text-[10px] text-gray-500">Bs. 0.00</p>
                </div>
                <div class="bg-gray-900/80 p-3 rounded-xl border border-gray-800">
                    <p class="text-[11px] text-gray-400">Ventas Totales</p>
                    <p id="dash-ventas-usd" class="text-base md:text-lg font-bold text-emerald-400 mt-0.5">$0.00</p>
                    <p id="dash-ventas-bs" class="text-[10px] text-gray-500">Bs. 0.00</p>
                </div>
                <div class="bg-gray-900/80 p-3 rounded-xl border border-gray-800">
                    <p class="text-[11px] text-gray-400">Ganancia Neta</p>
                    <p id="dash-ganancia-usd" class="text-base md:text-lg font-bold text-blue-400 mt-0.5">$0.00</p>
                    <p id="dash-ganancia-bs" class="text-[10px] text-gray-500">Bs. 0.00</p>
                </div>
                <div class="bg-yellow-950/30 p-3 rounded-xl border border-yellow-800/50">
                    <p class="text-[11px] gold-text font-semibold">Diezmo Total (10%)</p>
                    <p id="dash-diezmo-total-usd" class="text-base md:text-lg font-bold gold-text mt-0.5">$0.00</p>
                    <p id="dash-diezmo-total-bs" class="text-[10px] text-gray-400">Bs. 0.00</p>
                </div>
                <div class="bg-emerald-950/30 p-3 rounded-xl border border-emerald-800/50">
                    <p class="text-[11px] text-emerald-400 font-semibold">Diezmo Pendiente</p>
                    <p id="dash-diezmo-pendiente-usd" class="text-base md:text-lg font-bold text-emerald-400 mt-0.5">$0.00</p>
                    <p id="dash-diezmo-pendiente-bs" class="text-[10px] text-gray-400">Bs. 0.00</p>
                </div>
            </div>
        </section>

        <!-- 2. REGISTRO DE DIEZMO Y REGISTRO DE MOVIMIENTOS -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <!-- Registrar Producto / Mercancía -->
            <section class="card p-4">
                <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                    <i data-lucide="package-plus" class="w-4 h-4 gold-text"></i> Registrar / Editar Producto
                </h3>
                <form id="form-producto" class="space-y-3">
                    <input type="hidden" id="prod-id" value="">
                    <div>
                        <label class="text-[11px] text-gray-400 block mb-1">Nombre del Producto</label>
                        <input type="text" id="prod-nombre" placeholder="Ej. Harina de Maíz" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white focus:outline-none focus:border-yellow-500" required>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[11px] text-gray-400 block mb-1">Marca</label>
                            <input type="text" id="prod-marca" placeholder="Ej. PAN" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white">
                        </div>
                        <div>
                            <label class="text-[11px] text-gray-400 block mb-1">Tamaño / Presentación</label>
                            <input type="text" id="prod-tamano" placeholder="Ej. 1 kg / 1.5 L" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white">
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <label class="text-[11px] text-gray-400 block mb-1">Costo Inversión ($)</label>
                            <input type="number" step="0.01" id="prod-costo" placeholder="0.80" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                        </div>
                        <div>
                            <label class="text-[11px] text-gray-400 block mb-1">Precio Venta ($)</label>
                            <input type="number" step="0.01" id="prod-precio" placeholder="1.00" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                        </div>
                        <div>
                            <label class="text-[11px] text-gray-400 block mb-1">Stock Inicial</label>
                            <input type="number" id="prod-stock" placeholder="20" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                        </div>
                    </div>
                    <button type="submit" class="w-full py-2 gold-bg font-bold text-black text-xs rounded-lg hover:bg-yellow-600 transition">Guardar Producto</button>
                </form>
            </section>

            <!-- Registrar Entrada/Salida o Pago de Diezmo -->
            <section class="card p-4 space-y-4">
                <!-- Movimiento de Inventario -->
                <div>
                    <h3 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
                        <i data-lucide="arrow-left-right" class="w-4 h-4 gold-text"></i> Registrar Venta o Reposición
                    </h3>
                    <form id="form-movimiento" class="space-y-2">
                        <div>
                            <select id="mov-producto-id" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                                <!-- Productos cargados dinámicamente -->
                            </select>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div>
                                <select id="mov-tipo" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white">
                                    <option value="venta">Venta (Salida)</option>
                                    <option value="entrada">Reposición (Entrada)</option>
                                </select>
                            </div>
                            <div>
                                <input type="number" id="mov-cantidad" placeholder="Cantidad" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                            </div>
                            <div>
                                <input type="date" id="mov-fecha" class="w-full p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                            </div>
                        </div>
                        <button type="submit" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 font-bold text-white text-xs rounded-lg transition">Registrar Movimiento</button>
                    </form>
                </div>

                <!-- Entregar Diezmo -->
                <div class="pt-3 border-t border-gray-800">
                    <h3 class="text-sm font-bold text-yellow-400 mb-2 flex items-center gap-2">
                        <i data-lucide="heart-handshake" class="w-4 h-4"></i> Registrar Entrega de Diezmo
                    </h3>
                    <form id="form-diezmo" class="grid grid-cols-3 gap-2">
                        <input type="number" step="0.01" id="diezmo-monto" placeholder="Monto $" class="p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                        <input type="date" id="diezmo-fecha" class="p-2 bg-gray-900 border border-gray-800 rounded-lg text-xs text-white" required>
                        <button type="submit" class="py-2 bg-yellow-600 hover:bg-yellow-500 font-bold text-black text-xs rounded-lg transition">Abonar Diezmo</button>
                    </form>
                </div>
            </section>

        </div>

    </main>
</body>
</html>
